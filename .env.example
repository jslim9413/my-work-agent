# 1) 이 파일을 복사해서 이름을 .env 로 바꾸세요
# 2) https://openrouter.ai/keys 에서 발급받은 키를 넣으세요
OPENROUTER_API_KEY=sk-or-여기에-키-붙여넣기

# 도구 호출(function calling)을 지원하는 모델을 쓰세요
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1

# 실습 데이터 기준일 (강의 날짜와 상관없이 그대로 두세요)
AGENT_TODAY=2026-10-30

# 내 실제 업무폴더로 바꾸고 싶을 때 (비워두면 키트의 업무폴더 사용)
# WORK_DIR=C:/Users/나/Documents/업무  (윈도우 예시. 서버에서는 /home/유저명/업무 같은 리눅스 경로)

# ---- 2부: 배포용 설정 ----
# 웹 앱 입장 비밀번호 (비워두면 비밀번호 없음)
APP_PASSWORD=
# 접속 1회당 AI 질문 수 제한
MAX_QUESTIONS=20
